    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0001",
      "start": 0.0,
      "end": 7.98,
      "text": "hello兄弟们"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0002",
      "start": 7.98,
      "end": 8.44,
      "text": "我是旭哥"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0003",
      "start": 8.44,
      "end": 9.68,
      "text": "今天给大家带来一期"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0004",
      "start": 9.68,
      "end": 12.12,
      "text": "哥布林约会美女的技巧解析啊"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0005",
      "start": 12.12,
      "end": 14.28,
      "text": "这是一个开宝马的成熟姐姐"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0006",
      "start": 14.28,
      "end": 15.92,
      "text": "旭哥用了一系列的技巧"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0007",
      "start": 15.92,
      "end": 17.56,
      "text": "让她从一开始的抗拒"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0008",
      "start": 17.56,
      "end": 19.48,
      "text": "到最后跟我亲密互动了"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0009",
      "start": 19.48,
      "end": 20.82,
      "text": "还开车送我们回家"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0010",
      "start": 20.82,
      "end": 21.78,
      "text": "那如果你不知道"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0011",
      "start": 21.78,
      "end": 23.7,
      "text": "怎么快速的突破女生防备"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0012",
      "start": 23.7,
      "end": 25.02,
      "text": "拉近两个人的关系"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0013",
      "start": 25.02,
      "end": 26.34,
      "text": "今天这期视频看完"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0014",
      "start": 26.34,
      "end": 28.06,
      "text": "你将会功力大涨"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0015",
      "start": 28.06,
      "end": 28.88,
      "text": "好了闲话不多说"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0016",
      "start": 28.88,
      "end": 30.1,
      "text": "咱们直接开始"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0017",
      "start": 30.1,
      "end": 31.52,
      "text": "你是渣男"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0018",
      "start": 31.52,
      "end": 32.5,
      "text": "我是渣男"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0019",
      "start": 32.5,
      "end": 34.1,
      "text": "我去我就喜欢渣男"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0020",
      "start": 34.1,
      "end": 39.08,
      "text": "不好意思 帅哥"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0021",
      "start": 39.08,
      "end": 39.94,
      "text": "这是拍照呢"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0022",
      "start": 39.94,
      "end": 41.86,
      "text": "要不你帮我干嘛"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0023",
      "start": 41.86,
      "end": 42.64,
      "text": "我也想在这拍"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0024",
      "start": 42.64,
      "end": 43.6,
      "text": "你帮我拍完我就走"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0025",
      "start": 43.6,
      "end": 44.38,
      "text": "我就让给你"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0026",
      "start": 44.38,
      "end": 44.68,
      "text": "好不好"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0027",
      "start": 44.68,
      "end": 45.72,
      "text": "求你了"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0028",
      "start": 45.72,
      "end": 45.98,
      "text": "谢谢"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0029",
      "start": 45.98,
      "end": 48.16,
      "text": "因为你帮我拍完"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0030",
      "start": 48.16,
      "end": 48.94,
      "text": "我也帮你拍呗"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0031",
      "start": 48.94,
      "end": 50.1,
      "text": "我拍照贼好看"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0032",
      "start": 50.1,
      "end": 51.44,
      "text": "我拿过拍照奖"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0033",
      "start": 51.44,
      "end": 54.76,
      "text": "我是小红叔叔拍照博主"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0034",
      "start": 54.76,
      "end": 55.64,
      "text": "你知道余晓慧吗"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0035",
      "start": 55.64,
      "end": 57.08,
      "text": "余晓慧正好是我拍的"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0036",
      "start": 57.08,
      "end": 57.8,
      "text": "他多少啊"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0037",
      "start": 57.8,
      "end": 59.26,
      "text": "我给你搜一下"
    },
    {
      "id": "BV1f8Yj6aExQ-0000-0060-turbo-0038",
      "start": 59.26,
      "end": 60.0,
      "text": "来 这是鱼叫"
    }
  ]
