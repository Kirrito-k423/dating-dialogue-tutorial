  "segments": [
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0001",
      "start": 1125.0,
      "end": 1126.0,
      "text": "怎么啦"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0002",
      "start": 1126.0,
      "end": 1128.0,
      "text": "你是吗 是"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0003",
      "start": 1128.0,
      "end": 1130.0,
      "text": "你想我是单身吗"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0004",
      "start": 1130.0,
      "end": 1133.0,
      "text": "我想你就是呗 我想你就是"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0005",
      "start": 1133.0,
      "end": 1134.0,
      "text": "对"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0006",
      "start": 1134.0,
      "end": 1136.0,
      "text": "那我想"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0007",
      "start": 1136.0,
      "end": 1139.0,
      "text": "那我是单身你又怎样"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0008",
      "start": 1139.0,
      "end": 1144.0,
      "text": "你是单身我不能怎样 那你不是单身我就走了"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0009",
      "start": 1144.0,
      "end": 1147.0,
      "text": "你好直接啊 我第一次碰这么直接的 我去"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0010",
      "start": 1147.0,
      "end": 1150.0,
      "text": "那你喜欢直接的男人吗"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0011",
      "start": 1150.0,
      "end": 1151.0,
      "text": "你直接说你想干嘛"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0012",
      "start": 1151.0,
      "end": 1152.0,
      "text": "对 你平时见"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0013",
      "start": 1152.0,
      "end": 1156.0,
      "text": "这一长段的技巧啊 其实就是推中带拉"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0014",
      "start": 1156.0,
      "end": 1159.0,
      "text": "啥意思呢 就我表面上很直接的在拉近关系"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0015",
      "start": 1159.0,
      "end": 1162.0,
      "text": "但实际上我还会动不动的推开他一下"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0016",
      "start": 1162.0,
      "end": 1165.0,
      "text": "比如说 你看我一开始就特别直接 我吻他手"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0017",
      "start": 1165.0,
      "end": 1167.0,
      "text": "我说哇你好像 你看这就是很直接"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0018",
      "start": 1167.0,
      "end": 1168.0,
      "text": "一般男的是不敢这么干的"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0019",
      "start": 1168.0,
      "end": 1171.0,
      "text": "或者说我会直接去问他 你单身吗"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0020",
      "start": 1171.0,
      "end": 1173.0,
      "text": "你看这都是直接的拉伸关系"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0021",
      "start": 1173.0,
      "end": 1176.0,
      "text": "但是我会在这种拉伸中呢 浅浅的再推一下"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0022",
      "start": 1176.0,
      "end": 1179.0,
      "text": "不要一直拉 一直拉就会显得你有需求感了"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0023",
      "start": 1179.0,
      "end": 1180.0,
      "text": "你看我怎么推的呢"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0024",
      "start": 1180.0,
      "end": 1183.24,
      "text": "女生说,那我是单身,你想怎么样呢?"
    },
    {
      "id": "BV1f8Yj6aExQ-1125-1185-medium-0025",
      "start": 1183.24,
      "end": 1185.24,
      "text": "诶,这个时候,如果我说..."
    }
  ]
}
