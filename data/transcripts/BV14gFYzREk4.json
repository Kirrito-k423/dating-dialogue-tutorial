{
  "schema_version": 1,
  "bvid": "BV14gFYzREk4",
  "method": "whisper.cpp v1.9.5 small-q5_1; zh; Metal; beam_size=3; best_of=3; threads=4; unedited machine draft",
  "listening_verified": false,
  "created_at": "2026-10-14T17:03:18+08:00",
  "segments": [
    {
      "id": "BV14gFYzREk4-00001",
      "start": 0.0,
      "end": 11.4,
      "text": "好嘞兄弟們我是虛哥今天給大家帶來一期約會實戰技巧解析"
    },
    {
      "id": "BV14gFYzREk4-00002",
      "start": 11.4,
      "end": 14.0,
      "text": "這次咱們遇到了不少棘手的情況"
    },
    {
      "id": "BV14gFYzREk4-00003",
      "start": 14.0,
      "end": 15.64,
      "text": "女生跟我約會的時候直接說"
    },
    {
      "id": "BV14gFYzREk4-00004",
      "start": 15.64,
      "end": 18.48,
      "text": "這個不給女人付出的男人都是渣男"
    },
    {
      "id": "BV14gFYzREk4-00005",
      "start": 18.48,
      "end": 21.48,
      "text": "那麼今天你們會看到這種情況的應對方法"
    },
    {
      "id": "BV14gFYzREk4-00006",
      "start": 21.48,
      "end": 24.08,
      "text": "而且呢我們還約會遲到了女生又生氣了"
    },
    {
      "id": "BV14gFYzREk4-00007",
      "start": 24.08,
      "end": 25.8,
      "text": "看電影還遇到爛片了"
    },
    {
      "id": "BV14gFYzREk4-00008",
      "start": 25.8,
      "end": 27.36,
      "text": "這麼多突發情況"
    },
    {
      "id": "BV14gFYzREk4-00009",
      "start": 27.36,
      "end": 29.48,
      "text": "今天你們都會看到我是如何應對的"
    },
    {
      "id": "BV14gFYzREk4-00010",
      "start": 29.48,
      "end": 32.92,
      "text": "如果你們約會啊也是遇到各式各樣的突發情況"
    },
    {
      "id": "BV14gFYzREk4-00011",
      "start": 32.92,
      "end": 36.0,
      "text": "那麼今天這期視頻看完你就是知道怎麼處理了"
    },
    {
      "id": "BV14gFYzREk4-00012",
      "start": 36.0,
      "end": 38.2,
      "text": "好了顯化不多說咱們直接開始"
    },
    {
      "id": "BV14gFYzREk4-00013",
      "start": 48.96,
      "end": 52.8,
      "text": "這句話兄弟們你們怎麼回上來虛哥就已經遲到了"
    },
    {
      "id": "BV14gFYzREk4-00014",
      "start": 52.8,
      "end": 54.44,
      "text": "然後女生就已經不樂意了"
    },
    {
      "id": "BV14gFYzREk4-00015",
      "start": 54.44,
      "end": 58.68,
      "text": "因為我遲到了半點先把你們的應對方式給我摳在彈幕上"
    },
    {
      "id": "BV14gFYzREk4-00016",
      "start": 58.68,
      "end": 60.28,
      "text": "各位這個地方切記啊"
    },
    {
      "id": "BV14gFYzREk4-00017",
      "start": 60.28,
      "end": 62.76,
      "text": "千萬不要去解釋說什麼"
    },
    {
      "id": "BV14gFYzREk4-00018",
      "start": 62.76,
      "end": 65.56,
      "text": "哎呀堵車堵車不好意思出門晚了"
    },
    {
      "id": "BV14gFYzREk4-00019",
      "start": 65.56,
      "end": 66.6,
      "text": "怎麼怎麼樣的啊"
    },
    {
      "id": "BV14gFYzREk4-00020",
      "start": 66.6,
      "end": 68.8,
      "text": "你越解釋女生越會生氣"
    },
    {
      "id": "BV14gFYzREk4-00021",
      "start": 68.8,
      "end": 69.52,
      "text": "為什麼呢"
    },
    {
      "id": "BV14gFYzREk4-00022",
      "start": 69.52,
      "end": 72.0,
      "text": "因為解釋在女生的視角看來"
    },
    {
      "id": "BV14gFYzREk4-00023",
      "start": 72.0,
      "end": 73.04,
      "text": "你在推卸責任"
    },
    {
      "id": "BV14gFYzREk4-00024",
      "start": 73.04,
      "end": 76.52,
      "text": "就不管你說啊呀是堵車也好還是出門晚了也好"
    },
    {
      "id": "BV14gFYzREk4-00025",
      "start": 76.52,
      "end": 78.92,
      "text": "還是什麼在司機繞路也好"
    },
    {
      "id": "BV14gFYzREk4-00026",
      "start": 78.92,
      "end": 81.0,
      "text": "你都是在向女生傳遞一個信息"
    },
    {
      "id": "BV14gFYzREk4-00027",
      "start": 81.0,
      "end": 82.32,
      "text": "就是這不是我的問題"
    },
    {
      "id": "BV14gFYzREk4-00028",
      "start": 82.32,
      "end": 84.48,
      "text": "你不能賴我這都是別人的問題"
    },
    {
      "id": "BV14gFYzREk4-00029",
      "start": 84.48,
      "end": 87.36,
      "text": "那麼通過你這樣的一個行為女生就能判斷"
    },
    {
      "id": "BV14gFYzREk4-00030",
      "start": 87.36,
      "end": 89.92,
      "text": "你這個男人不是一個值得依靠的男人"
    },
    {
      "id": "BV14gFYzREk4-00031",
      "start": 89.92,
      "end": 92.88,
      "text": "以後我跟你在一起遇到任何事你也解決不了"
    },
    {
      "id": "BV14gFYzREk4-00032",
      "start": 92.88,
      "end": 94.28,
      "text": "然後你犯了任何錯啊"
    },
    {
      "id": "BV14gFYzREk4-00033",
      "start": 94.28,
      "end": 95.88,
      "text": "你也會推卸到別人身上"
    },
    {
      "id": "BV14gFYzREk4-00034",
      "start": 95.88,
      "end": 98.76,
      "text": "甚至可能有人欺負我或者我需要幫助了"
    },
    {
      "id": "BV14gFYzREk4-00035",
      "start": 98.76,
      "end": 100.68,
      "text": "你都會臨陣脫逃"
    },
    {
      "id": "BV14gFYzREk4-00036",
      "start": 100.68,
      "end": 102.16,
      "text": "你這種男人就不是一個強者"
    },
    {
      "id": "BV14gFYzREk4-00037",
      "start": 102.16,
      "end": 103.64,
      "text": "不是一個值得依靠的男人"
    },
    {
      "id": "BV14gFYzREk4-00038",
      "start": 103.64,
      "end": 105.76,
      "text": "因為一個真正的強者是自己的錯"
    },
    {
      "id": "BV14gFYzREk4-00039",
      "start": 105.76,
      "end": 106.92,
      "text": "挨打就立正"
    },
    {
      "id": "BV14gFYzREk4-00040",
      "start": 106.92,
      "end": 107.48,
      "text": "是我的錯"
    },
    {
      "id": "BV14gFYzREk4-00041",
      "start": 107.48,
      "end": 108.56,
      "text": "我就認錯我就改錯"
    },
    {
      "id": "BV14gFYzREk4-00042",
      "start": 108.56,
      "end": 110.6,
      "text": "我就彌補我就扛責"
    },
    {
      "id": "BV14gFYzREk4-00043",
      "start": 110.6,
      "end": 114.36,
      "text": "所以說咱們的回答一定是要承認自己的問題"
    },
    {
      "id": "BV14gFYzREk4-00044",
      "start": 114.36,
      "end": 118.2,
      "text": "一定要扛責然後我們付出代價去彌補就行了"
    },
    {
      "id": "BV14gFYzREk4-00045",
      "start": 134.88,
      "end": 136.08,
      "text": "嘿嘿兄弟們"
    },
    {
      "id": "BV14gFYzREk4-00046",
      "start": 136.08,
      "end": 137.96,
      "text": "咱們直接轉一話題"
    },
    {
      "id": "BV14gFYzREk4-00047",
      "start": 137.96,
      "end": 141.08,
      "text": "而且直接跟他敲定第二天的約會"
    },
    {
      "id": "BV14gFYzREk4-00048",
      "start": 141.08,
      "end": 142.64,
      "text": "遇到這種突發情況"
    },
    {
      "id": "BV14gFYzREk4-00049",
      "start": 142.64,
      "end": 145.12,
      "text": "記住不要把小錯給放大"
    },
    {
      "id": "BV14gFYzREk4-00050",
      "start": 145.12,
      "end": 146.16,
      "text": "馬上轉一話題"
    },
    {
      "id": "BV14gFYzREk4-00051",
      "start": 146.16,
      "end": 149.6,
      "text": "把這個事給大事話小小事話聊給他掠過去"
    },
    {
      "id": "BV14gFYzREk4-00052",
      "start": 149.6,
      "end": 150.48,
      "text": "遇到問題"
    },
    {
      "id": "BV14gFYzREk4-00053",
      "start": 150.48,
      "end": 154.4,
      "text": "轉移話題是一個最簡單最適合新手的處理方法"
    },
    {
      "id": "BV14gFYzREk4-00054",
      "start": 154.4,
      "end": 155.76,
      "text": "如果你腦袋反應不快的話"
    },
    {
      "id": "BV14gFYzREk4-00055",
      "start": 155.76,
      "end": 156.68,
      "text": "馬上轉移話題"
    },
    {
      "id": "BV14gFYzREk4-00056",
      "start": 156.68,
      "end": 158.4,
      "text": "你想不到說第二天玩密室"
    },
    {
      "id": "BV14gFYzREk4-00057",
      "start": 158.4,
      "end": 160.28,
      "text": "你就說那這樣我一會請你看個電影"
    },
    {
      "id": "BV14gFYzREk4-00058",
      "start": 160.28,
      "end": 162.0,
      "text": "哎呀這樣一會吃飯我買單吧"
    },
    {
      "id": "BV14gFYzREk4-00059",
      "start": 162.0,
      "end": 163.32,
      "text": "這是最簡單的一個方法"
    },
    {
      "id": "BV14gFYzREk4-00060",
      "start": 163.32,
      "end": 165.0,
      "text": "你們以後就記住這一招就行了"
    },
    {
      "id": "BV14gFYzREk4-00061",
      "start": 165.0,
      "end": 166.2,
      "text": "不用跟他解釋任何東西"
    },
    {
      "id": "BV14gFYzREk4-00062",
      "start": 166.2,
      "end": 169.64,
      "text": "而且女生還會覺得你是一個願意承擔責任的男人"
    },
    {
      "id": "BV14gFYzREk4-00063",
      "start": 169.64,
      "end": 171.64,
      "text": "不會因為你這個小錯去扣你的分"
    },
    {
      "id": "BV14gFYzREk4-00064",
      "start": 171.64,
      "end": 175.32,
      "text": "當然了女生不會因為你這麼一招就馬上不生氣了"
    },
    {
      "id": "BV14gFYzREk4-00065",
      "start": 175.32,
      "end": 176.96,
      "text": "所以我們接下來要做的是什麼呢"
    },
    {
      "id": "BV14gFYzREk4-00066",
      "start": 176.96,
      "end": 178.56,
      "text": "就是持續推進這個約會"
    },
    {
      "id": "BV14gFYzREk4-00067",
      "start": 178.56,
      "end": 180.68,
      "text": "馬上進入下一環節該吃飯吃飯"
    },
    {
      "id": "BV14gFYzREk4-00068",
      "start": 180.68,
      "end": 181.76,
      "text": "該逛街逛街"
    },
    {
      "id": "BV14gFYzREk4-00069",
      "start": 181.76,
      "end": 184.8,
      "text": "這樣的話在行動中慢慢女生就把這件事忘了"
    },
    {
      "id": "BV14gFYzREk4-00070",
      "start": 184.8,
      "end": 186.16,
      "text": "情緒也就慢慢回來了"
    },
    {
      "id": "BV14gFYzREk4-00071",
      "start": 186.16,
      "end": 188.12,
      "text": "好接下來看一下點菜的環節"
    },
    {
      "id": "BV14gFYzREk4-00072",
      "start": 196.76,
      "end": 198.0,
      "text": "這句話你們會怎麼回"
    },
    {
      "id": "BV14gFYzREk4-00073",
      "start": 198.0,
      "end": 200.08,
      "text": "女生說萬一你點的我不喜歡吃怎麼辦"
    },
    {
      "id": "BV14gFYzREk4-00074",
      "start": 200.08,
      "end": 201.36,
      "text": "很多人就說那你來點"
    },
    {
      "id": "BV14gFYzREk4-00075",
      "start": 201.36,
      "end": 203.2,
      "text": "記住再跟女生相處的時候"
    },
    {
      "id": "BV14gFYzREk4-00076",
      "start": 203.2,
      "end": 204.36,
      "text": "千萬不要悠悠鬱鬱的"
    },
    {
      "id": "BV14gFYzREk4-00077",
      "start": 204.36,
      "end": 205.64,
      "text": "一會說我來點"
    },
    {
      "id": "BV14gFYzREk4-00078",
      "start": 205.64,
      "end": 207.76,
      "text": "一會女生說我想點你就給他點"
    },
    {
      "id": "BV14gFYzREk4-00079",
      "start": 207.76,
      "end": 209.6,
      "text": "然後一會又說他不知道點啥你又"
    },
    {
      "id": "BV14gFYzREk4-00080",
      "start": 209.6,
      "end": 212.4,
      "text": "那我來點越是這樣你的吸引力就越在下降"
    },
    {
      "id": "BV14gFYzREk4-00081",
      "start": 212.4,
      "end": 214.16,
      "text": "因為女生會覺得體驗感非常不好"
    },
    {
      "id": "BV14gFYzREk4-00082",
      "start": 214.16,
      "end": 216.28,
      "text": "會覺得你這個男人搖擺不定沒有組件"
    },
    {
      "id": "BV14gFYzREk4-00083",
      "start": 216.28,
      "end": 217.92,
      "text": "記住如果你在跟女生相處的時候"
    },
    {
      "id": "BV14gFYzREk4-00084",
      "start": 217.92,
      "end": 220.72,
      "text": "你做了一個決定你就要堅持讓你這個決定是對的"
    },
    {
      "id": "BV14gFYzREk4-00085",
      "start": 220.72,
      "end": 222.92,
      "text": "堅持住不要來回搖擺不定"
    },
    {
      "id": "BV14gFYzREk4-00086",
      "start": 222.92,
      "end": 224.48,
      "text": "所以當時我說我來點菜的時候"
    },
    {
      "id": "BV14gFYzREk4-00087",
      "start": 224.48,
      "end": 226.96,
      "text": "哪怕他提出質疑了我們也要堅持我們的選擇"
    },
    {
      "id": "BV14gFYzREk4-00088",
      "start": 226.96,
      "end": 228.12,
      "text": "好第二個點是什麼呢"
    },
    {
      "id": "BV14gFYzREk4-00089",
      "start": 228.12,
      "end": 230.6,
      "text": "在約會的時候盡量不要讓女生點菜"
    },
    {
      "id": "BV14gFYzREk4-00090",
      "start": 230.6,
      "end": 232.4,
      "text": "為什麼呢很多兄弟會想"
    },
    {
      "id": "BV14gFYzREk4-00091",
      "start": 232.4,
      "end": 234.8,
      "text": "我讓女生點菜這不是顯得我很尊重她嗎"
    },
    {
      "id": "BV14gFYzREk4-00092",
      "start": 234.8,
      "end": 235.76,
      "text": "顯得我很深視嗎"
    },
    {
      "id": "BV14gFYzREk4-00093",
      "start": 235.76,
      "end": 237.08,
      "text": "但其實大錯特錯"
    },
    {
      "id": "BV14gFYzREk4-00094",
      "start": 237.08,
      "end": 238.64,
      "text": "站在女生的視角來看"
    },
    {
      "id": "BV14gFYzREk4-00095",
      "start": 238.64,
      "end": 241.48,
      "text": "你讓我點菜會顯得你這個男生沒有組件"
    },
    {
      "id": "BV14gFYzREk4-00096",
      "start": 241.48,
      "end": 243.44,
      "text": "而且一般女生都不會點菜"
    },
    {
      "id": "BV14gFYzREk4-00097",
      "start": 243.44,
      "end": 244.68,
      "text": "她都不知道該點啥"
    },
    {
      "id": "BV14gFYzREk4-00098",
      "start": 244.68,
      "end": 246.2,
      "text": "反而她會覺得很煩"
    },
    {
      "id": "BV14gFYzREk4-00099",
      "start": 246.2,
      "end": 249.16,
      "text": "女生喜歡的是能被她依靠的男人"
    },
    {
      "id": "BV14gFYzREk4-00100",
      "start": 249.16,
      "end": 251.56,
      "text": "什麼東西都能替我擺平的男人"
    },
    {
      "id": "BV14gFYzREk4-00101",
      "start": 251.56,
      "end": 253.16,
      "text": "你連點個菜你都擺不平"
    },
    {
      "id": "BV14gFYzREk4-00102",
      "start": 253.16,
      "end": 254.28,
      "text": "你都得聽我的意見"
    },
    {
      "id": "BV14gFYzREk4-00103",
      "start": 254.28,
      "end": 255.96,
      "text": "以後更大的事你能擺平嗎"
    },
    {
      "id": "BV14gFYzREk4-00104",
      "start": 255.96,
      "end": 260.44,
      "text": "所以說我們只需要象徵性的表現出尊重她的口味"
    },
    {
      "id": "BV14gFYzREk4-00105",
      "start": 260.44,
      "end": 261.0,
      "text": "就行了"
    },
    {
      "id": "BV14gFYzREk4-00106",
      "start": 261.0,
      "end": 262.6,
      "text": "但不要真的讓她去點"
    },
    {
      "id": "BV14gFYzREk4-00107",
      "start": 262.6,
      "end": 263.44,
      "text": "比如說你可以問她"
    },
    {
      "id": "BV14gFYzREk4-00108",
      "start": 263.44,
      "end": 264.92,
      "text": "你喜歡吃甜的喜歡吃辣的"
    },
    {
      "id": "BV14gFYzREk4-00109",
      "start": 264.92,
      "end": 266.44,
      "text": "你平時喜歡吃什麼口味的"
    },
    {
      "id": "BV14gFYzREk4-00110",
      "start": 266.44,
      "end": 268.96,
      "text": "然後根據她的口味我們來替她點"
    },
    {
      "id": "BV14gFYzREk4-00111",
      "start": 268.96,
      "end": 270.96,
      "text": "這樣的話女生就會覺得你又尊重她"
    },
    {
      "id": "BV14gFYzREk4-00112",
      "start": 270.96,
      "end": 272.2,
      "text": "但是你又值得依靠"
    },
    {
      "id": "BV14gFYzREk4-00113",
      "start": 272.2,
      "end": 274.52,
      "text": "所以這句話我是當時這麼應對的"
    },
    {
      "id": "BV14gFYzREk4-00114",
      "start": 274.52,
      "end": 275.72,
      "text": "那你就不吃吧"
    },
    {
      "id": "BV14gFYzREk4-00115",
      "start": 275.72,
      "end": 276.52,
      "text": "陪我說完了"
    },
    {
      "id": "BV14gFYzREk4-00116",
      "start": 276.52,
      "end": 278.32,
      "text": "我再陪你去吃你喜歡吃的吧"
    },
    {
      "id": "BV14gFYzREk4-00117",
      "start": 279.4,
      "end": 282.36,
      "text": "也不要覺得女生會不會覺得我大男子主意"
    },
    {
      "id": "BV14gFYzREk4-00118",
      "start": 282.36,
      "end": 285.16,
      "text": "你記住有的時候你可以大男子主意一點"
    },
    {
      "id": "BV14gFYzREk4-00119",
      "start": 285.16,
      "end": 287.8,
      "text": "但是有的時候你要尊重女生的選擇"
    },
    {
      "id": "BV14gFYzREk4-00120",
      "start": 287.8,
      "end": 290.08,
      "text": "後面會教大家該在什麼時候做什麼事"
    },
    {
      "id": "BV14gFYzREk4-00121",
      "start": 291.16,
      "end": 292.56,
      "text": "一會兒有恐怖片大家去看吧"
    },
    {
      "id": "BV14gFYzREk4-00122",
      "start": 293.44,
      "end": 295.0,
      "text": "我不想看恐怖片"
    },
    {
      "id": "BV14gFYzREk4-00123",
      "start": 295.0,
      "end": 296.56,
      "text": "我還怕"
    },
    {
      "id": "BV14gFYzREk4-00124",
      "start": 296.56,
      "end": 298.16,
      "text": "害怕你就叫好哥不就行了"
    },
    {
      "id": "BV14gFYzREk4-00125",
      "start": 299.24,
      "end": 300.36,
      "text": "我是被經常認得了嗎"
    },
    {
      "id": "BV14gFYzREk4-00126",
      "start": 301.56,
      "end": 302.8,
      "text": "咋樣"
    },
    {
      "id": "BV14gFYzREk4-00127",
      "start": 302.8,
      "end": 304.76,
      "text": "就是帶他們去看恐怖片"
    },
    {
      "id": "BV14gFYzREk4-00128",
      "start": 305.64,
      "end": 306.6,
      "text": "不要站便宜是吧"
    },
    {
      "id": "BV14gFYzREk4-00129",
      "start": 307.88,
      "end": 309.04,
      "text": "那麼兄弟們"
    },
    {
      "id": "BV14gFYzREk4-00130",
      "start": 309.04,
      "end": 312.12,
      "text": "這句話你們會怎麼應對呢"
    },
    {
      "id": "BV14gFYzREk4-00131",
      "start": 312.12,
      "end": 315.48,
      "text": "女生說你是不是經常約女生去看恐怖片"
    },
    {
      "id": "BV14gFYzREk4-00132",
      "start": 315.48,
      "end": 317.56,
      "text": "然後賺他們便宜呢"
    },
    {
      "id": "BV14gFYzREk4-00133",
      "start": 317.56,
      "end": 320.56,
      "text": "哎很多兄弟在這個時候就會解釋了吧"
    },
    {
      "id": "BV14gFYzREk4-00134",
      "start": 320.56,
      "end": 321.44,
      "text": "沒有沒有"
    },
    {
      "id": "BV14gFYzREk4-00135",
      "start": 321.44,
      "end": 323.24,
      "text": "我很少約女孩去看恐怖片"
    },
    {
      "id": "BV14gFYzREk4-00136",
      "start": 323.24,
      "end": 325.44,
      "text": "哎我約你看電影真的只是為了看電影"
    },
    {
      "id": "BV14gFYzREk4-00137",
      "start": 325.44,
      "end": 326.52,
      "text": "哎你不要想太多"
    },
    {
      "id": "BV14gFYzREk4-00138",
      "start": 326.52,
      "end": 328.44,
      "text": "越解釋越顯得你心虛"
    },
    {
      "id": "BV14gFYzREk4-00139",
      "start": 328.44,
      "end": 331.16,
      "text": "解釋就是演示演示就是事實"
    },
    {
      "id": "BV14gFYzREk4-00140",
      "start": 331.16,
      "end": 333.84,
      "text": "那麼這句話看敘哥是怎麼應對的"
    },
    {
      "id": "BV14gFYzREk4-00141",
      "start": 334.92,
      "end": 336.04,
      "text": "你要站便宜是吧"
    },
    {
      "id": "BV14gFYzREk4-00142",
      "start": 337.16,
      "end": 339.04,
      "text": "那你也太記住我了"
    },
    {
      "id": "BV14gFYzREk4-00143",
      "start": 339.04,
      "end": 340.2,
      "text": "我要是想站便宜的話"
    },
    {
      "id": "BV14gFYzREk4-00144",
      "start": 340.2,
      "end": 342.44,
      "text": "我還需要帶你去看恐怖片嗎"
    },
    {
      "id": "BV14gFYzREk4-00145",
      "start": 342.44,
      "end": 343.4,
      "text": "在哪不能站啊"
    },
    {
      "id": "BV14gFYzREk4-00146",
      "start": 345.96,
      "end": 348.04,
      "text": "兄弟們學會了嗎"
    },
    {
      "id": "BV14gFYzREk4-00147",
      "start": 348.04,
      "end": 349.52,
      "text": "所以很多時候啊"
    },
    {
      "id": "BV14gFYzREk4-00148",
      "start": 349.52,
      "end": 352.04,
      "text": "我們遇到女生對我們產生質疑"
    },
    {
      "id": "BV14gFYzREk4-00149",
      "start": 352.04,
      "end": 353.4,
      "text": "千萬不用解釋"
    },
    {
      "id": "BV14gFYzREk4-00150",
      "start": 353.4,
      "end": 354.4,
      "text": "你要承認"
    },
    {
      "id": "BV14gFYzREk4-00151",
      "start": 354.4,
      "end": 356.4,
      "text": "有的時候大大方方的承認"
    },
    {
      "id": "BV14gFYzREk4-00152",
      "start": 356.4,
      "end": 357.76,
      "text": "反而女生喜歡"
    },
    {
      "id": "BV14gFYzREk4-00153",
      "start": 357.76,
      "end": 359.0,
      "text": "你明明心裡有鬼"
    },
    {
      "id": "BV14gFYzREk4-00154",
      "start": 359.0,
      "end": 360.68,
      "text": "你明明心裡對她有好感"
    },
    {
      "id": "BV14gFYzREk4-00155",
      "start": 360.68,
      "end": 362.92,
      "text": "你就想要跟她拉近關係"
    },
    {
      "id": "BV14gFYzREk4-00156",
      "start": 362.92,
      "end": 364.12,
      "text": "你又不敢承認"
    },
    {
      "id": "BV14gFYzREk4-00157",
      "start": 364.12,
      "end": 365.4,
      "text": "反而會顯得猥瑣"
    },
    {
      "id": "BV14gFYzREk4-00158",
      "start": 365.4,
      "end": 366.32,
      "text": "什麼是猥瑣呢"
    },
    {
      "id": "BV14gFYzREk4-00159",
      "start": 366.32,
      "end": 368.2,
      "text": "就是心口故意就是猥瑣"
    },
    {
      "id": "BV14gFYzREk4-00160",
      "start": 368.2,
      "end": 369.96,
      "text": "心裡想要嘴上有演示"
    },
    {
      "id": "BV14gFYzREk4-00161",
      "start": 369.96,
      "end": 371.28,
      "text": "在女生看來就很猥瑣"
    },
    {
      "id": "BV14gFYzREk4-00162",
      "start": 371.28,
      "end": 373.04,
      "text": "心裡想要大大方方說出來了"
    },
    {
      "id": "BV14gFYzREk4-00163",
      "start": 373.04,
      "end": 374.32,
      "text": "反而女生能接受"
    },
    {
      "id": "BV14gFYzREk4-00164",
      "start": 374.32,
      "end": 376.48,
      "text": "因為女生覺得你是一個敢做敢當的男人"
    },
    {
      "id": "BV14gFYzREk4-00165",
      "start": 376.48,
      "end": 378.48,
      "text": "技術敢做敢當是很重要的"
    },
    {
      "id": "BV14gFYzREk4-00166",
      "start": 378.48,
      "end": 381.28,
      "text": "只不過你去拉近關係的這個方式"
    },
    {
      "id": "BV14gFYzREk4-00167",
      "start": 381.28,
      "end": 383.2,
      "text": "不要太激進就好了"
    },
    {
      "id": "BV14gFYzREk4-00168",
      "start": 383.2,
      "end": 385.12,
      "text": "你不要說我要想站你便宜"
    },
    {
      "id": "BV14gFYzREk4-00169",
      "start": 385.12,
      "end": 386.16,
      "text": "我還用去電影院嗎"
    },
    {
      "id": "BV14gFYzREk4-00170",
      "start": 386.16,
      "end": 386.96,
      "text": "我現在就能站"
    },
    {
      "id": "BV14gFYzREk4-00171",
      "start": 386.96,
      "end": 387.8,
      "text": "碰著別人"
    },
    {
      "id": "BV14gFYzREk4-00172",
      "start": 387.8,
      "end": 388.96,
      "text": "就上去就親一口"
    },
    {
      "id": "BV14gFYzREk4-00173",
      "start": 388.96,
      "end": 389.4,
      "text": "那完了"
    },
    {
      "id": "BV14gFYzREk4-00174",
      "start": 389.4,
      "end": 391.04,
      "text": "那你這場約會肯定廢了"
    },
    {
      "id": "BV14gFYzREk4-00175",
      "start": 391.04,
      "end": 392.0,
      "text": "稍微浪漫一點"
    },
    {
      "id": "BV14gFYzREk4-00176",
      "start": 392.0,
      "end": 393.12,
      "text": "靠在她肩膀上"
    },
    {
      "id": "BV14gFYzREk4-00177",
      "start": 393.12,
      "end": 394.64,
      "text": "不要過於激進就行了"
    },
    {
      "id": "BV14gFYzREk4-00178",
      "start": 394.64,
      "end": 396.8,
      "text": "但是你看你大大方方的就好了"
    },
    {
      "id": "BV14gFYzREk4-00179",
      "start": 396.8,
      "end": 398.28,
      "text": "而且你提前看出來"
    },
    {
      "id": "BV14gFYzREk4-00180",
      "start": 398.28,
      "end": 399.88,
      "text": "這個女生看你的眼神啊"
    },
    {
      "id": "BV14gFYzREk4-00181",
      "start": 399.88,
      "end": 401.4,
      "text": "之前有一個笑容啊"
    },
    {
      "id": "BV14gFYzREk4-00182",
      "start": 401.4,
      "end": 403.2,
      "text": "你就知道其實她對你是有好感的"
    },
    {
      "id": "BV14gFYzREk4-00183",
      "start": 403.2,
      "end": 404.48,
      "text": "哪怕你遲到了她生氣了"
    },
    {
      "id": "BV14gFYzREk4-00184",
      "start": 404.48,
      "end": 406.24,
      "text": "但她對你還是有好感的嘛"
    },
    {
      "id": "BV14gFYzREk4-00185",
      "start": 406.24,
      "end": 408.32,
      "text": "有的時候人太老實了"
    },
    {
      "id": "BV14gFYzREk4-00186",
      "start": 408.32,
      "end": 409.52,
      "text": "反而女生不喜歡"
    },
    {
      "id": "BV14gFYzREk4-00187",
      "start": 409.52,
      "end": 410.92,
      "text": "為什麼女生不喜歡老實人"
    },
    {
      "id": "BV14gFYzREk4-00188",
      "start": 410.92,
      "end": 412.56,
      "text": "因為老實人就沒有這種情調"
    },
    {
      "id": "BV14gFYzREk4-00189",
      "start": 412.56,
      "end": 413.88,
      "text": "為什麼女生喜歡壞男生"
    },
    {
      "id": "BV14gFYzREk4-00190",
      "start": 413.88,
      "end": 414.68,
      "text": "因為壞男生"
    },
    {
      "id": "BV14gFYzREk4-00191",
      "start": 414.68,
      "end": 415.84,
      "text": "她就是會用這種方式"
    },
    {
      "id": "BV14gFYzREk4-00192",
      "start": 415.84,
      "end": 417.24,
      "text": "給女生一種浪漫的感覺"
    },
    {
      "id": "BV14gFYzREk4-00193",
      "start": 417.24,
      "end": 419.2,
      "text": "給女生一種情緒波動的感覺"
    },
    {
      "id": "BV14gFYzREk4-00194",
      "start": 419.2,
      "end": 421.2,
      "text": "好那接下來是一段深入的對話"
    },
    {
      "id": "BV14gFYzREk4-00195",
      "start": 421.2,
      "end": 422.0,
      "text": "大家可以聽一下"
    },
    {
      "id": "BV14gFYzREk4-00196",
      "start": 422.0,
      "end": 423.08,
      "text": "這段對話我覺得很關鍵"
    },
    {
      "id": "BV14gFYzREk4-00197",
      "start": 423.08,
      "end": 436.48,
      "text": "好兄弟們"
    },
    {
      "id": "BV14gFYzREk4-00198",
      "start": 436.48,
      "end": 438.24,
      "text": "這句話你們會怎麼應對"
    },
    {
      "id": "BV14gFYzREk4-00199",
      "start": 438.24,
      "end": 439.2,
      "text": "很多女生都會說"
    },
    {
      "id": "BV14gFYzREk4-00200",
      "start": 439.2,
      "end": 441.2,
      "text": "哎呦男生都是靠嘴巴說說"
    },
    {
      "id": "BV14gFYzREk4-00201",
      "start": 441.2,
      "end": 442.64,
      "text": "從來不付出實際行動"
    },
    {
      "id": "BV14gFYzREk4-00202",
      "start": 442.64,
      "end": 445.24,
      "text": "給女生花錢的男人不一定是愛她的"
    },
    {
      "id": "BV14gFYzREk4-00203",
      "start": 445.24,
      "end": 446.96,
      "text": "但是不給她花錢的一定不愛她"
    },
    {
      "id": "BV14gFYzREk4-00204",
      "start": 446.96,
      "end": 447.92,
      "text": "你們會怎麼應對呢"
    },
    {
      "id": "BV14gFYzREk4-00205",
      "start": 447.92,
      "end": 450.04,
      "text": "這裡先給大家看我的回答"
    },
    {
      "id": "BV14gFYzREk4-00206",
      "start": 450.04,
      "end": 452.4,
      "text": "其實現在很多男生不是不付出"
    },
    {
      "id": "BV14gFYzREk4-00207",
      "start": 452.4,
      "end": 455.44,
      "text": "他是怕自己的付出得不到最等的回報"
    },
    {
      "id": "BV14gFYzREk4-00208",
      "start": 455.44,
      "end": 456.64,
      "text": "就很多男生付出了很多"
    },
    {
      "id": "BV14gFYzREk4-00209",
      "start": 456.64,
      "end": 458.6,
      "text": "最後女生還不是離開了嗎"
    },
    {
      "id": "BV14gFYzREk4-00210",
      "start": 458.6,
      "end": 460.68,
      "text": "就是男生其實也去安全了"
    },
    {
      "id": "BV14gFYzREk4-00211",
      "start": 460.68,
      "end": 462.32,
      "text": "你得讓覺得我的付出"
    },
    {
      "id": "BV14gFYzREk4-00212",
      "start": 462.32,
      "end": 463.28,
      "text": "你不會離開我"
    },
    {
      "id": "BV14gFYzREk4-00213",
      "start": 463.28,
      "end": 464.64,
      "text": "你得給男生安全感"
    },
    {
      "id": "BV14gFYzREk4-00214",
      "start": 464.64,
      "end": 467.0,
      "text": "所以有的時候不是男生的問題"
    },
    {
      "id": "BV14gFYzREk4-00215",
      "start": 467.0,
      "end": 468.84,
      "text": "其實也是女生的問題"
    },
    {
      "id": "BV14gFYzREk4-00216",
      "start": 468.84,
      "end": 471.04,
      "text": "男生是需要安全感的"
    },
    {
      "id": "BV14gFYzREk4-00217",
      "start": 471.04,
      "end": 471.92,
      "text": "當然需要了"
    },
    {
      "id": "BV14gFYzREk4-00218",
      "start": 471.92,
      "end": 473.4,
      "text": "男生比女生更需要安全感"
    },
    {
      "id": "BV14gFYzREk4-00219",
      "start": 473.4,
      "end": 476.68,
      "text": "因為男生付出的是自己的血汗"
    },
    {
      "id": "BV14gFYzREk4-00220",
      "start": 476.68,
      "end": 478.24,
      "text": "嘿嘿兄弟們"
    },
    {
      "id": "BV14gFYzREk4-00221",
      "start": 478.24,
      "end": 481.08,
      "text": "這段對話給我好好的寫一百點"
    },
    {
      "id": "BV14gFYzREk4-00222",
      "start": 481.08,
      "end": 482.2,
      "text": "這裡我要說一下"
    },
    {
      "id": "BV14gFYzREk4-00223",
      "start": 482.2,
      "end": 484.96,
      "text": "其實我說的我感覺就是大部分兄弟的心理話"
    },
    {
      "id": "BV14gFYzREk4-00224",
      "start": 484.96,
      "end": 485.88,
      "text": "但是大部分兄弟呢"
    },
    {
      "id": "BV14gFYzREk4-00225",
      "start": 485.88,
      "end": 487.28,
      "text": "他不敢跟女生說這樣的話"
    },
    {
      "id": "BV14gFYzREk4-00226",
      "start": 487.28,
      "end": 488.64,
      "text": "因為他怕他說了這樣的話"
    },
    {
      "id": "BV14gFYzREk4-00227",
      "start": 488.64,
      "end": 489.88,
      "text": "女生不喜歡聽"
    },
    {
      "id": "BV14gFYzREk4-00228",
      "start": 489.88,
      "end": 491.0,
      "text": "然後就把她給PASS了"
    },
    {
      "id": "BV14gFYzREk4-00229",
      "start": 491.0,
      "end": 492.24,
      "text": "但是我要告訴大家"
    },
    {
      "id": "BV14gFYzREk4-00230",
      "start": 492.24,
      "end": 494.04,
      "text": "你不要去擔心女生會把你PASS掉"
    },
    {
      "id": "BV14gFYzREk4-00231",
      "start": 494.04,
      "end": 495.48,
      "text": "就算她真的把你PASS掉了"
    },
    {
      "id": "BV14gFYzREk4-00232",
      "start": 495.48,
      "end": 497.48,
      "text": "也是一個跟你不同品的女生"
    },
    {
      "id": "BV14gFYzREk4-00233",
      "start": 497.48,
      "end": 499.08,
      "text": "這種女生我們不要也罷"
    },
    {
      "id": "BV14gFYzREk4-00234",
      "start": 499.08,
      "end": 501.16,
      "text": "我們真的就是要把我們的心理話"
    },
    {
      "id": "BV14gFYzREk4-00235",
      "start": 501.16,
      "end": 502.84,
      "text": "公平公正的說出來"
    },
    {
      "id": "BV14gFYzREk4-00236",
      "start": 502.84,
      "end": 504.12,
      "text": "我們就是要告訴女生"
    },
    {
      "id": "BV14gFYzREk4-00237",
      "start": 504.12,
      "end": 505.88,
      "text": "我們的價值觀是什麼樣子的"
    },
    {
      "id": "BV14gFYzREk4-00238",
      "start": 505.88,
      "end": 506.88,
      "text": "讓女生明白"
    },
    {
      "id": "BV14gFYzREk4-00239",
      "start": 506.88,
      "end": 510.44,
      "text": "我不是一個你可以隨意套路我騙我的傻子"
    },
    {
      "id": "BV14gFYzREk4-00240",
      "start": 510.44,
      "end": 512.68,
      "text": "我有我的一套戀愛的原則"
    },
    {
      "id": "BV14gFYzREk4-00241",
      "start": 512.68,
      "end": 513.84,
      "text": "我有我的世界觀"
    },
    {
      "id": "BV14gFYzREk4-00242",
      "start": 513.84,
      "end": 515.16,
      "text": "如果她不認同"
    },
    {
      "id": "BV14gFYzREk4-00243",
      "start": 515.16,
      "end": 516.12,
      "text": "我們可以讓她走"
    },
    {
      "id": "BV14gFYzREk4-00244",
      "start": 516.12,
      "end": 517.24,
      "text": "我們可以換下一個人"
    },
    {
      "id": "BV14gFYzREk4-00245",
      "start": 517.24,
      "end": 519.36,
      "text": "記住了總有認同你的女生"
    },
    {
      "id": "BV14gFYzREk4-00246",
      "start": 519.36,
      "end": 519.84,
      "text": "這樣的話"
    },
    {
      "id": "BV14gFYzREk4-00247",
      "start": 519.84,
      "end": 521.88,
      "text": "我們也能篩選出來真正的好女兒"
    },
    {
      "id": "BV14gFYzREk4-00248",
      "start": 521.88,
      "end": 522.56,
      "text": "跟你在一起"
    },
    {
      "id": "BV14gFYzREk4-00249",
      "start": 522.56,
      "end": 525.76,
      "text": "所以一定要大膽的向女生表達自己的觀點"
    },
    {
      "id": "BV14gFYzREk4-00250",
      "start": 525.76,
      "end": 527.28,
      "text": "第二就是我這段話裡面"
    },
    {
      "id": "BV14gFYzREk4-00251",
      "start": 527.28,
      "end": 530.64,
      "text": "其實我巧妙的用了一個小小的手段"
    },
    {
      "id": "BV14gFYzREk4-00252",
      "start": 530.64,
      "end": 531.92,
      "text": "就是我跟女生說"
    },
    {
      "id": "BV14gFYzREk4-00253",
      "start": 531.92,
      "end": 534.0,
      "text": "我們男生不向女生付出"
    },
    {
      "id": "BV14gFYzREk4-00254",
      "start": 534.0,
      "end": 536.4,
      "text": "有的時候是我們男生沒有安全感"
    },
    {
      "id": "BV14gFYzREk4-00255",
      "start": 536.4,
      "end": 539.44,
      "text": "你得向我們證明你是真的愛我們的"
    },
    {
      "id": "BV14gFYzREk4-00256",
      "start": 539.44,
      "end": 541.16,
      "text": "我們自然會向你付出"
    },
    {
      "id": "BV14gFYzREk4-00257",
      "start": 541.16,
      "end": 543.84,
      "text": "那麼如果女生她想要得到你的付出"
    },
    {
      "id": "BV14gFYzREk4-00258",
      "start": 543.84,
      "end": 547.0,
      "text": "她就得先向你證明她愛你"
    },
    {
      "id": "BV14gFYzREk4-00259",
      "start": 547.0,
      "end": 547.96,
      "text": "那她怎麼證明呢"
    },
    {
      "id": "BV14gFYzREk4-00260",
      "start": 547.96,
      "end": 549.84,
      "text": "就得她先向你付出了"
    },
    {
      "id": "BV14gFYzREk4-00261",
      "start": 549.84,
      "end": 552.36,
      "text": "哎這樣其實咱們在這場博弈中"
    },
    {
      "id": "BV14gFYzREk4-00262",
      "start": 552.36,
      "end": 553.76,
      "text": "也能佔據上風"
    },
    {
      "id": "BV14gFYzREk4-00263",
      "start": 553.76,
      "end": 554.6,
      "text": "不吃虧"
    },
    {
      "id": "BV14gFYzREk4-00264",
      "start": 554.6,
      "end": 555.2,
      "text": "明白了嗎"
    },
    {
      "id": "BV14gFYzREk4-00265",
      "start": 555.2,
      "end": 556.96,
      "text": "兄弟們多了不說了"
    },
    {
      "id": "BV14gFYzREk4-00266",
      "start": 556.96,
      "end": 557.72,
      "text": "說了不好"
    },
    {
      "id": "BV14gFYzREk4-00267",
      "start": 557.72,
      "end": 559.48,
      "text": "好接下來是一段牽手小技巧"
    },
    {
      "id": "BV14gFYzREk4-00268",
      "start": 559.48,
      "end": 560.88,
      "text": "如果你想牽女生的手"
    },
    {
      "id": "BV14gFYzREk4-00269",
      "start": 560.88,
      "end": 561.96,
      "text": "當然又不知道怎麼說"
    },
    {
      "id": "BV14gFYzREk4-00270",
      "start": 561.96,
      "end": 563.56,
      "text": "那麼直接看下面人的操作"
    },
    {
      "id": "BV14gFYzREk4-00271",
      "start": 563.56,
      "end": 565.64,
      "text": "前提是你要判斷出女生有窗口"
    },
    {
      "id": "BV14gFYzREk4-00272",
      "start": 565.64,
      "end": 566.96,
      "text": "要不我幫你拿高高"
    },
    {
      "id": "BV14gFYzREk4-00273",
      "start": 566.96,
      "end": 568.16,
      "text": "感覺有點重"
    },
    {
      "id": "BV14gFYzREk4-00274",
      "start": 568.16,
      "end": 569.56,
      "text": "不用"
    },
    {
      "id": "BV14gFYzREk4-00275",
      "start": 569.56,
      "end": 570.28,
      "text": "沒關係"
    },
    {
      "id": "BV14gFYzREk4-00276",
      "start": 570.28,
      "end": 571.48,
      "text": "我身世一點"
    },
    {
      "id": "BV14gFYzREk4-00277",
      "start": 571.48,
      "end": 572.48,
      "text": "來我幫你拿"
    },
    {
      "id": "BV14gFYzREk4-00278",
      "start": 577.48,
      "end": 578.48,
      "text": "我怎麼感覺"
    },
    {
      "id": "BV14gFYzREk4-00279",
      "start": 578.48,
      "end": 579.84,
      "text": "幫你拿包手有點冷"
    },
    {
      "id": "BV14gFYzREk4-00280",
      "start": 579.84,
      "end": 581.0,
      "text": "我有點後悔"
    },
    {
      "id": "BV14gFYzREk4-00281",
      "start": 581.6,
      "end": 582.76,
      "text": "要不這樣"
    },
    {
      "id": "BV14gFYzREk4-00282",
      "start": 582.76,
      "end": 583.96,
      "text": "你幫我握手吧"
    },
    {
      "id": "BV14gFYzREk4-00283",
      "start": 587.64,
      "end": 588.32,
      "text": "學會了嗎"
    },
    {
      "id": "BV14gFYzREk4-00284",
      "start": 588.32,
      "end": 589.44,
      "text": "這段不用解釋"
    },
    {
      "id": "BV14gFYzREk4-00285",
      "start": 589.44,
      "end": 590.72,
      "text": "唯一要注意的就是"
    },
    {
      "id": "BV14gFYzREk4-00286",
      "start": 590.72,
      "end": 593.28,
      "text": "必須要女生有窗口才能去用這招"
    },
    {
      "id": "BV14gFYzREk4-00287",
      "start": 593.28,
      "end": 594.88,
      "text": "怎麼去判斷女生有沒有窗口呢"
    },
    {
      "id": "BV14gFYzREk4-00288",
      "start": 594.88,
      "end": 596.92,
      "text": "記住了看女生看你的眼神"
    },
    {
      "id": "BV14gFYzREk4-00289",
      "start": 596.92,
      "end": 598.68,
      "text": "他如果看你的眼神是這樣的"
    },
    {
      "id": "BV14gFYzREk4-00290",
      "start": 600.12,
      "end": 600.6,
      "text": "對吧"
    },
    {
      "id": "BV14gFYzREk4-00291",
      "start": 600.6,
      "end": 601.2,
      "text": "然後沒事"
    },
    {
      "id": "BV14gFYzREk4-00292",
      "start": 601.2,
      "end": 602.88,
      "text": "還有一些小動作"
    },
    {
      "id": "BV14gFYzREk4-00293",
      "start": 602.88,
      "end": 604.84,
      "text": "領裡頭髮"
    },
    {
      "id": "BV14gFYzREk4-00294",
      "start": 604.84,
      "end": 606.76,
      "text": "拿咖啡一直在這喝"
    },
    {
      "id": "BV14gFYzREk4-00295",
      "start": 606.76,
      "end": 608.56,
      "text": "天天最蠢"
    },
    {
      "id": "BV14gFYzREk4-00296",
      "start": 608.56,
      "end": 610.2,
      "text": "這些小動作越多"
    },
    {
      "id": "BV14gFYzREk4-00297",
      "start": 610.2,
      "end": 612.24,
      "text": "說明這女生對你窗口越大"
    },
    {
      "id": "BV14gFYzREk4-00298",
      "start": 612.24,
      "end": 613.32,
      "text": "那接下來就是看電影"
    },
    {
      "id": "BV14gFYzREk4-00299",
      "start": 613.32,
      "end": 614.52,
      "text": "遇到爛片該怎麼辦"
    },
    {
      "id": "BV14gFYzREk4-00300",
      "start": 614.52,
      "end": 615.28,
      "text": "大家記住"
    },
    {
      "id": "BV14gFYzREk4-00301",
      "start": 615.28,
      "end": 616.64,
      "text": "一旦遇到爛片"
    },
    {
      "id": "BV14gFYzREk4-00302",
      "start": 616.64,
      "end": 617.64,
      "text": "中途馬上離場"
    },
    {
      "id": "BV14gFYzREk4-00303",
      "start": 617.64,
      "end": 619.0,
      "text": "千萬不要把這個爛片看完"
    },
    {
      "id": "BV14gFYzREk4-00304",
      "start": 619.0,
      "end": 620.64,
      "text": "因為爛片看的時間越長"
    },
    {
      "id": "BV14gFYzREk4-00305",
      "start": 620.64,
      "end": 621.52,
      "text": "女生就越無聊"
    },
    {
      "id": "BV14gFYzREk4-00306",
      "start": 621.52,
      "end": 622.72,
      "text": "你的吸引力就再下降"
    },
    {
      "id": "BV14gFYzREk4-00307",
      "start": 622.72,
      "end": 624.48,
      "text": "所以說千萬不要新城電票錢"
    },
    {
      "id": "BV14gFYzREk4-00308",
      "start": 624.48,
      "end": 625.64,
      "text": "馬上中途離場"
    },
    {
      "id": "BV14gFYzREk4-00309",
      "start": 625.64,
      "end": 627.28,
      "text": "去找下一個有意思的項目"
    },
    {
      "id": "BV14gFYzREk4-00310",
      "start": 627.28,
      "end": 628.68,
      "text": "所以當時重返基金零"
    },
    {
      "id": "BV14gFYzREk4-00311",
      "start": 628.68,
      "end": 629.56,
      "text": "我們看一半"
    },
    {
      "id": "BV14gFYzREk4-00312",
      "start": 629.56,
      "end": 630.8,
      "text": "我直接離場了"
    },
    {
      "id": "BV14gFYzREk4-00313",
      "start": 630.8,
      "end": 632.24,
      "text": "就出現了接下來的對話"
    },
    {
      "id": "BV14gFYzREk4-00314",
      "start": 650.16,
      "end": 650.68,
      "text": "兄弟們"
    },
    {
      "id": "BV14gFYzREk4-00315",
      "start": 650.68,
      "end": 651.76,
      "text": "關鍵點來了"
    },
    {
      "id": "BV14gFYzREk4-00316",
      "start": 651.76,
      "end": 653.2,
      "text": "如果這種情況下"
    },
    {
      "id": "BV14gFYzREk4-00317",
      "start": 653.2,
      "end": 655.28,
      "text": "女生雖然嘴上在猶豫"
    },
    {
      "id": "BV14gFYzREk4-00318",
      "start": 655.28,
      "end": 658.32,
      "text": "但是她眼睛寒情默默的看著你"
    },
    {
      "id": "BV14gFYzREk4-00319",
      "start": 658.32,
      "end": 659.52,
      "text": "那麼最後這一招"
    },
    {
      "id": "BV14gFYzREk4-00320",
      "start": 659.52,
      "end": 660.76,
      "text": "徐哥送給你"
    },
    {
      "id": "BV14gFYzREk4-00321",
      "start": 660.76,
      "end": 662.2,
      "text": "要不去你家"
    },
    {
      "id": "BV14gFYzREk4-00322",
      "start": 662.2,
      "end": 663.44,
      "text": "啊"
    },
    {
      "id": "BV14gFYzREk4-00323",
      "start": 663.44,
      "end": 663.68,
      "text": "不是"
    },
    {
      "id": "BV14gFYzREk4-00324",
      "start": 663.68,
      "end": 664.96,
      "text": "本來我想去私人院"
    },
    {
      "id": "BV14gFYzREk4-00325",
      "start": 664.96,
      "end": 666.4,
      "text": "當然我覺得私人院"
    },
    {
      "id": "BV14gFYzREk4-00326",
      "start": 666.4,
      "end": 668.0,
      "text": "我有潔癖你知道吧"
    },
    {
      "id": "BV14gFYzREk4-00327",
      "start": 668.0,
      "end": 669.32,
      "text": "去我家也不合適啊"
    },
    {
      "id": "BV14gFYzREk4-00328",
      "start": 669.32,
      "end": 670.6,
      "text": "去你家畢竟是你主場"
    },
    {
      "id": "BV14gFYzREk4-00329",
      "start": 670.6,
      "end": 671.44,
      "text": "是"
    },
    {
      "id": "BV14gFYzREk4-00330",
      "start": 672.8,
      "end": 674.04,
      "text": "哎呀走吧走吧走吧"
    },
    {
      "id": "BV14gFYzREk4-00331",
      "start": 674.04,
      "end": 675.0,
      "text": "氣氛都到了"
    },
    {
      "id": "BV14gFYzREk4-00332",
      "start": 681.28,
      "end": 681.88,
      "text": "好的兄弟們"
    },
    {
      "id": "BV14gFYzREk4-00333",
      "start": 681.88,
      "end": 683.92,
      "text": "那麼今天的約會視頻就到這了"
    },
    {
      "id": "BV14gFYzREk4-00334",
      "start": 683.92,
      "end": 684.96,
      "text": "我們總結一下"
    },
    {
      "id": "BV14gFYzREk4-00335",
      "start": 684.96,
      "end": 686.44,
      "text": "大膽表達自己的價值觀"
    },
    {
      "id": "BV14gFYzREk4-00336",
      "start": 686.44,
      "end": 687.4,
      "text": "遇到女生生氣"
    },
    {
      "id": "BV14gFYzREk4-00337",
      "start": 687.4,
      "end": 688.8,
      "text": "不要解釋直接帶領"
    },
    {
      "id": "BV14gFYzREk4-00338",
      "start": 688.8,
      "end": 689.84,
      "text": "拉伸關係之前"
    },
    {
      "id": "BV14gFYzREk4-00339",
      "start": 689.84,
      "end": 691.16,
      "text": "要判斷窗口"
    },
    {
      "id": "BV14gFYzREk4-00340",
      "start": 691.16,
      "end": 692.56,
      "text": "覺得乾貨的直接一鍵三連"
    },
    {
      "id": "BV14gFYzREk4-00341",
      "start": 692.56,
      "end": 693.96,
      "text": "如果你有喜歡的女生追不到"
    },
    {
      "id": "BV14gFYzREk4-00342",
      "start": 693.96,
      "end": 695.24,
      "text": "或者想要跟徐哥學習"
    },
    {
      "id": "BV14gFYzREk4-00343",
      "start": 695.24,
      "end": 696.76,
      "text": "提升情商的看指定評論"
    },
    {
      "id": "BV14gFYzREk4-00344",
      "start": 696.76,
      "end": 697.56,
      "text": "或者主業簽名"
    },
    {
      "id": "BV14gFYzREk4-00345",
      "start": 697.56,
      "end": 698.44,
      "text": "來找到我本人"
    },
    {
      "id": "BV14gFYzREk4-00346",
      "start": 698.44,
      "end": 699.64,
      "text": "我來幫你關注徐哥"
    },
    {
      "id": "BV14gFYzREk4-00347",
      "start": 699.64,
      "end": 701.6,
      "text": "一周一次最實用的情感乾貨"
    },
    {
      "id": "BV14gFYzREk4-00348",
      "start": 701.6,
      "end": 703.28,
      "text": "我們下期再見"
    }
  ]
}
